FROM node:22-alpine AS frontend

WORKDIR /var/www

COPY package*.json ./
RUN npm ci

COPY resources ./resources
COPY public ./public
COPY vite.config.js .env.docker ./
RUN npm run build -- --mode docker

FROM php:8.4-fpm-bookworm

WORKDIR /var/www

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx supervisor unzip libzip-dev libsqlite3-dev \
    && docker-php-ext-install pdo_sqlite zip pcntl \
    && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY . .
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

COPY --from=frontend /var/www/public/build ./public/build
COPY docker/hub/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/hub/supervisord.conf /etc/supervisor/conf.d/realtime-chat.conf
COPY docker/hub/entrypoint.sh /usr/local/bin/realtime-chat-start

RUN chmod +x /usr/local/bin/realtime-chat-start \
    && mkdir -p /data \
    && chown -R www-data:www-data /var/www /data

EXPOSE 80 8080
VOLUME ["/data"]

ENTRYPOINT ["/usr/local/bin/realtime-chat-start"]
